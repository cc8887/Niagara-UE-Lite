{
  "FileVersion": 3,
  "Description": "Native Niagara authoring and cooked preview CLI",
  "DisableEnginePluginsByDefault": true,
  "Modules": [
    {"Name":"NiagaraStandalone", "Type":"Runtime", "LoadingPhase":"Default"},
    {"Name":"NiagaraStandaloneEditor", "Type":"Editor", "LoadingPhase":"Default"}
  ],
  "Plugins": [
    {"Name":"Niagara", "Enabled":true},
    {"Name":"PythonScriptPlugin", "Enabled":true, "TargetAllowList":["Editor"]},
    {"Name":"EditorScriptingUtilities", "Enabled":true, "TargetAllowList":["Editor"]}
  ]
}
